# ------------------------------------------------------------------
# Copy this file to ".env"  (cp .env.example .env)  and edit the values.
#
# NEW: You no longer have to configure your Uptime Kuma servers here. Just start the
# container, open the page, and add your server(s) from the Settings ▸ Servers panel
# (alias, URL, username, password). You can add as many Kuma servers as you like.
# Everything below is optional.
# ------------------------------------------------------------------

# --- Credential encryption key (recommended) ---
# Server passwords you enter in the UI are stored ENCRYPTED on the data volume. This key
# is what unlocks them. Set any long random string here and keep it secret + stable:
# with it set, a copied/stolen data volume is useless to anyone without this key.
# If you leave it blank, the app auto-generates a key into /app/data/secret.key so setup
# stays zero-config — but that key lives in the same volume, so it does NOT protect a
# copied volume. For real at-rest protection, set your own value and don't change it.
#   Generate one:  python -c "import secrets;print(secrets.token_urlsafe(48))"
KFM_SECRET_KEY=

# --- First-run seed (optional) ---
# If these are set AND you have no servers configured yet, the app creates your first
# server from them automatically on first start (handy for upgrades). After that, manage
# servers in the web UI. Leave blank to start with an empty "add your first server" page.
KUMA_URL=
KUMA_USERNAME=
KUMA_PASSWORD=

# How often (seconds) to read live status from a server's socket cache.
KUMA_POLL_INTERVAL=2

# --- Demo mode ---
# true  = ignore configured servers and show fake, randomly-flipping sensors (great for a
#         first look, or when this host can't reach any Kuma).
# false = connect to the server(s) you add in the UI.
DEMO_MODE=false

# --- Networking ---
# Host port published on your Ubuntu box. The app always listens on 8000
# *inside* the container. 8848 is the default — change it if that port is already in use.
HOST_PORT=8848

# Interface to bind on the host:
#   0.0.0.0     -> reachable from anywhere on your LAN (default)
#   192.168.1.225  -> only on that specific NIC
#   127.0.0.1   -> only reachable via a reverse proxy running on this box
# NOTE: the app has its own admin login (you create it on first run). On a trusted LAN
# 0.0.0.0 is fine; to expose it beyond your LAN, front it with a reverse proxy over HTTPS.
HOST_BIND=0.0.0.0
